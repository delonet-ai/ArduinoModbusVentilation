{
    "title": "Arduino ventilation controller",
    "device_type": "arduino_modbus_servo",
    "group": "g-diy",
    "device": {
        "name": "Вентиляция",
        "id": "arduino_modbus_slave",
        "min_read_registers": 1,
        "max_read_registers": 20,
        "frame_timeout_ms": 100,
        "guard_interval_us": 5000,
        "groups": [
            {
                "title": "Modes",
                "id": "modes"
            },
            {
                "title": "Rooms",
                "id": "rooms"
            },
            {
                "title": "Status",
                "id": "status"
            }
        ],
        "channels": [
            {
                "name": "Fireplace_mode",
                "reg_type": "holding",
                "address": 19,
                "type": "switch",
                "group": "modes"
            },
            {
                "name": "Kitchen",
                "reg_type": "holding",
                "address": 0,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "rooms"
            },
            {
                "name": "Cabinet",
                "reg_type": "holding",
                "address": 1,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "rooms"
            },
            {
                "name": "Bedroom",
                "reg_type": "holding",
                "address": 2,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "rooms"
            },
            {
                "name": "Living",
                "reg_type": "holding",
                "address": 3,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "rooms"
            },
            {
                "name": "Kid",
                "reg_type": "holding",
                "address": 4,
                "type": "range",
                "min": 0,
                "max": 100,
                "units": "%",
                "group": "rooms"
            },
            {
                "name": "Exhaust_total",
                "reg_type": "holding",
                "address": 15,
                "type": "value",
                "readonly": true,
                "units": "%",
                "group": "status"
            },
            {
                "name": "Supply_total",
                "reg_type": "holding",
                "address": 16,
                "type": "value",
                "readonly": true,
                "units": "%",
                "group": "status"
            },
            {
                "name": "Controller_ready",
                "reg_type": "holding",
                "address": 18,
                "type": "switch",
                "readonly": true,
                "group": "status"
            }
        ],
        "translations": {
            "en": {
                "Modes": "Modes",
                "Rooms": "Rooms",
                "Status": "Status"
            },
            "ru": {
                "Modes": "Режимы",
                "Rooms": "Комнаты",
                "Status": "Состояние",
                "Fireplace_mode": "Режим камина",
                "Kitchen": "Кухня",
                "Cabinet": "Кабинет",
                "Bedroom": "Спальня",
                "Living": "Гостиная",
                "Kid": "Детская",
                "Exhaust_total": "Сумма вытяжки",
                "Supply_total": "Сумма притока",
                "Controller_ready": "PCA9685 готов"
            }
        }
    }
}
